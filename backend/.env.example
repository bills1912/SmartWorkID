# MongoDB Atlas connection string
# Salin dari MongoDB Atlas → Connect → Drivers
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=kerjaai

# CORS — pisahkan dengan koma, sesuaikan dengan domain frontend Railway Anda
CORS_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.railway.app

# Secret key untuk JWT (generate dengan: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-secret-key
